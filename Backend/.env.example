# =================================================================
# Q-BioForge Backend Production Configuration Template
# =================================================================

# Environment Mode: 'development' or 'production'
ENVIRONMENT=production

# Server Host & Port (Render dynamically provisions PORT)
HOST=0.0.0.0
PORT=8000
DEBUG=false

# CORS Configuration: Front-end origin URL (Render static site or local Vite)
FRONTEND_URL=https://q-bioforge-frontend.onrender.com
ALLOWED_ORIGINS=https://q-bioforge-frontend.onrender.com,http://localhost:5173

# Compute Backend Architecture:
# - 'render-local' or 'local': In-process CPU simulation for web API & lightweight inference
# - 'DGX': Classical High-Performance Computing cluster (NVIDIA DGX B200) for large-scale training
COMPUTE_BACKEND=render-local

# Optional DGX Cluster endpoint (Leaves empty if DGX worker is internal / not connected)
DGX_ENDPOINT=

# Public Render Safety & Resource Guards
MAX_PUBLIC_QUBITS=8
MAX_PUBLIC_DEPTH=4
MAX_PUBLIC_EXPERIMENTS=2
MAX_PUBLIC_RUNTIME_SECONDS=60

# Storage & Persistence Paths
# Note: SQLite database on Render is ephemeral without persistent disk.
DATABASE_PATH=results/q_bioforge.db
DATABASE_URL=sqlite:///results/q_bioforge.db
DATASETS_DIR=datasets
MODELS_DIR=models
RESULTS_DIR=results
